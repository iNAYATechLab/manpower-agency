  "description": "iNAYATechLab Inc. - Manpower Supply SaaS Platform | Multi-Tenant Workforce Management System",
  "author": "iNAYATechLab Inc. <iNAYATechLab@gmail.com>",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "gift:push": "bash scripts/push-to-gift.sh",
    "gift:release": "node scripts/gift-release.mjs",
    "gift:dry-run": "node scripts/gift-release.mjs --dry-run --version=v1.0.0 --phase=\"Phase 1 (Steps 1-20)\"",
    "vercel:build": "next build",
    "vercel:deploy": "vercel --prod --confirm",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.408.0",
    "next": "14.2.5",
    "next-themes": "0.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.5.2",
    "tailwindcss-animate": "1.0.7",
    "@prisma/client": "5.14.0"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "eslint-config-prettier": "9.1.0",
    "postcss": "8.4.40",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.6",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "prisma": "5.14.0",
    "vitest": "1.6.0",
    "@vitest/coverage-v8": "1.6.0"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iNAYATechLab/manpower-agency.git"
